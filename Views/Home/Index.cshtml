@model DashboardViewModel

@{
    ViewData["Title"] = "Campus Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold">Campus Service Dashboard</h2>
        <p class="text-muted">
            Overview of campus maintenance and student service requests.
        </p>
    </div>

    <div>
        <a asp-controller="ServiceRequests"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> New Request
        </a>

        <a asp-controller="Students"
           asp-action="Register"
           class="btn btn-outline-primary">
            Register Student
        </a>
    </div>

</div>

<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card dashboard-card border-0 shadow-sm">
            <div class="card-body">
                <i class="bi bi-collection-fill fs-2 text-primary"></i>
                <h6 class="text-muted mt-3">Total Requests</h6>
                <h2>@Model.TotalRequests</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card dashboard-card border-0 shadow-sm">
            <div class="card-body">
                <i class="bi bi-hourglass-split fs-2 text-warning"></i>
                <h6 class="text-muted mt-3">Pending</h6>
                <h2>@Model.PendingRequests</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card dashboard-card border-0 shadow-sm">
            <div class="card-body">
                <i class="bi bi-gear-fill fs-2 text-info"></i>
                <h6 class="text-muted mt-3">In Progress</h6>
                <h2>@Model.InProgressRequests</h2>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card dashboard-card border-0 shadow-sm">
            <div class="card-body">
                <i class="bi bi-check-circle-fill fs-2 text-success"></i>
                <h6 class="text-muted mt-3">Completed</h6>
                <h2>@Model.CompletedRequests</h2>
            </div>
        </div>
    </div>

</div>

<div class="card border-0 shadow-sm">

    <div class="card-header bg-white py-3">
        <h5 class="mb-0">
            <i class="bi bi-clock-history text-primary"></i>
            Recent Service Requests
        </h5>
    </div>

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Student</th>
                    <th>Category</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.RecentRequests.Any())
                {
                    @foreach (var item in Model.RecentRequests)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.StudentName</td>
                            <td>@item.Category</td>
                            <td>@item.SubmissionDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (item.Status == "In Progress")
                                {
                                    <span class="badge bg-info">In Progress</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Completed</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="ServiceRequests"
                                   asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4">
                            No service requests found.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>
</div>
